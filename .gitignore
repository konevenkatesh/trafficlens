# The datastore holds the surveys AND the OpenRouter/RunPod keys (lab_settings). It must
# never leave this machine. Backups included -- a .bak is the same secrets, older.
app/*.db
app/*.db-wal
app/*.db-shm
app/*.db.bak-*
data/*.db*

# Footage, and everything derived from it. Hundreds of gigabytes, regenerable, and the
# recordings themselves are client material.
lab_work/
lab_gold/
survey_out/
app/axle_crops/
app/renders/
*.mp4
*.avi
*.mkv
*.dav

# Benchmark scratch: 3GB of segments and results. The tracker config is the one thing in
# here the engine actually needs at runtime, so it is kept.
benchmark/*
!benchmark/bytetrack_low.yaml

# No weights in the repo. This is source only: 147MB of .pt files would dominate every
# clone, and git stores binaries badly -- each retrain adds the whole file again.
#
# The weights live as assets on a GitHub Release instead, and the Windows build downloads
# them before freezing, so the .exe a surveyor gets still has everything inside it and
# never phones home. See .github/workflows/build-survey-exe.yml.
models/

# Environment and noise
.venv/
__pycache__/
*.pyc
.DS_Store
build/
dist/
*.spec.bak
node_modules/

# Training data and per-station working output. 5.8GB and 1.6GB respectively, tens of
# thousands of frames and label files. This is the Lab's raw material, versioned by the
# runs that produced it, not source — and none of it is needed to build the survey app.
dataset/
stations/
runs/
app/reports_out/

# A 2.1GB dataset tarball, an empty stray database, and a downloaded RunPod binary.
# GitHub rejects any file over 100MB, so the tarball would fail the push outright.
*.tgz
*.tar.gz
/trafficlens.db
bin/

# Past client deliverables. Not needed to build the app, and client material does not
# belong in a build repo even a private one.
delivery/
